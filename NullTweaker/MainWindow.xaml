<Window x:Class="NullTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NullTweaker" Width="1320" Height="840" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="FilesDropped" Closing="WindowClosing" PreviewKeyDown="KeyPressed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Margin="8,10,8,12">
            <StackPanel DockPanel.Dock="Top">
                <RadioButton x:Name="WeaponsNav" Style="{StaticResource NavItem}" Tag="&#xE7FC;" Content="Weapons" Checked="NavChecked"/>
                <RadioButton x:Name="MapsNav" Style="{StaticResource NavItem}" Tag="&#xE707;" Content="Maps" Checked="NavChecked"/>
                <RadioButton x:Name="NPCNav" Style="{StaticResource NavItem}" Tag="&#xE77B;" Content="NPCs" Checked="NavChecked"/>
                <RadioButton x:Name="CustomizationNav" Style="{StaticResource NavItem}" Tag="&#xE790;" Content="Customization" Checked="NavChecked"/>
                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="6,10,6,14"/>
                <TextBlock x:Name="FilesHeader" Text="Open files" Style="{StaticResource Secondary}" Margin="14,0,0,6"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Style="{StaticResource SubtleButton}" Click="NewClicked" ToolTip="Ctrl+N">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="3,0,14,0"/>
                        <TextBlock x:Name="NewText" Text="New weapon"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Click="OpenClicked" ToolTip="Ctrl+O. You can also drop files onto the window.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Margin="3,0,14,0"/>
                        <TextBlock Text="Open file..."/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <ListBox x:Name="Files" SelectionChanged="FileSelected" ItemContainerStyle="{StaticResource FileItem}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </DockPanel>

        <!-- Editor -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="440"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <Grid x:Name="HeaderPanel" DockPanel.Dock="Top" Margin="36,26,28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="DocumentTitle" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DocumentInfo" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="1,2,0,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Height="32">
                            <Button Style="{DynamicResource AccentButtonStyle}" Click="SaveClicked" ToolTip="Ctrl+S" MinWidth="96">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Save"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Save as..." Click="SaveAsClicked" Margin="8,0,0,0" ToolTip="Ctrl+Shift+S"/>
                            <Button Margin="8,0,0,0" Click="PreviewToggled" ToolTip="Show or hide the generated JSON">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE943;" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="PreviewToggleText" Text="Hide JSON"/>
                                </StackPanel>
                            </Button>
                            <Button Click="MoreClicked" Margin="8,0,0,0" ToolTip="More actions">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="SearchRow" DockPanel.Dock="Top" Margin="36,18,28,6" Width="320" HorizontalAlignment="Left">
                        <TextBox x:Name="Search" TextChanged="SearchChanged"/>
                        <TextBlock x:Name="SearchHint" Text="Find a setting  (Ctrl+F)" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </Grid>

                    <StackPanel x:Name="Banners" DockPanel.Dock="Top" Margin="36,10,28,0"/>

                    <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Form" Margin="36,0,28,36"/>
                    </ScrollViewer>
                </DockPanel>

                <Border x:Name="PreviewPane" Grid.Column="1" Width="380" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="18,20,12,10">
                            <Button x:Name="CopyButton" Style="{StaticResource SubtleButton}" DockPanel.Dock="Right" Click="CopyClicked" ToolTip="Copy the JSON to the clipboard">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="CopyText" Text="Copy"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="JSON" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PreviewFile" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="10,1,0,0"/>
                        </DockPanel>
                        <TextBox x:Name="Preview" Style="{StaticResource CodeView}" Padding="18,0,8,12"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
